# Copy this file to .env and fill in real values before running locally.
# On a host like Render/Railway, set these as environment variables in their
# dashboard instead of uploading a .env file.

# A long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The email address YOU register with. Only this account gets admin access
# (GET /api/admin/users). Everyone else who registers is a normal user.
ADMIN_EMAIL=you@example.com

# Most hosts set this automatically — only needed for running locally.
PORT=3000
