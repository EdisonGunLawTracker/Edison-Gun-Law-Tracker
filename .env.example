# Copy this file to .env and fill in real values before running locally.
# On a host like Render/Railway, set these as environment variables in their
# dashboard instead of uploading a .env file.

# A long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The email address YOU register with. Only this account gets admin access
# (GET /api/admin/users). Everyone else who registers is a normal user.
ADMIN_EMAIL=you@example.com

# REQUIRED for data to survive a restart/redeploy. Without these two, everyone
# who registers is stored in a local file that most hosts (including Render)
# wipe on every restart — so signups quietly disappear. Fix:
#   1. Create a free project at https://supabase.com (no card needed).
#   2. In the SQL editor, run once:
#        create table app_state (id int primary key, data jsonb not null default '{}'::jsonb);
#   3. Project Settings -> API -> copy the "Project URL" and the
#      "service_role" secret key (NOT the "anon" key — that one can't write).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Most hosts set this automatically — only needed for running locally.
PORT=3000

# Powers the "recent bill activity" feature (LegiScan API, free tier).
# Get this from your LegiScan account -> Account -> API page.
# Leave blank to disable the feature — the app just won't show bill activity.
LEGISCAN_API_KEY=

# Optional — powers the "recent court rulings" feature (CourtListener API,
# a free nonprofit legal database). The feature works fine with this left
# blank (CourtListener allows anonymous requests), but a free token from
# your CourtListener account -> profile -> API page makes it more reliable.
COURTLISTENER_API_TOKEN=
